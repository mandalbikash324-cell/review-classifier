# Select exactly one provider: openai, gemini, or openrouter
LLM_PROVIDER=openrouter

# Add a key for the selected provider. Never commit real API keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Paste your real OpenRouter key after the equals sign; do not include angle brackets.
OPENROUTER_API_KEY=

# Provider models
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenRouter: reasoning on, plus an optional second verification request.
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_VERIFY_RESPONSE=true
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Review Lens

# App and input limits
API_TIMEOUT_SECONDS=20
MAX_REVIEW_WORDS=500
MAX_IMAGE_MB=5
MAX_IMAGE_DIMENSION=1024